# ── Copiez ce fichier en .env et remplissez vos valeurs ──────────────────────
# cp .env.example .env
#
# ⚠️  SÉCURITÉ — règles impératives :
#   1. Ne jamais committer .env dans git (il est dans .gitignore ✓).
#   2. En production : DJANGO_DEBUG=False OBLIGATOIRE.
#      DEBUG=True expose stack trace, settings et SECRET_KEY → fuite garantie.
#   3. Générez une SECRET_KEY unique par environnement (dev ≠ prod) :
#      python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
#   4. Révoquez toute clé exposée accidentellement (log, copier-coller…).

# ── Django ────────────────────────────────────────────────────────────────────
DJANGO_SECRET_KEY=change-me-with-a-unique-generated-secret-key

# ⚠️  DOIT être False en production
DJANGO_DEBUG=False

# Hôtes autorisés en prod (séparés par des virgules)
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# ── Base de données ───────────────────────────────────────────────────────────
# En prod : URL Postgres (Neon, Supabase, Vercel Postgres…)
# Ex : postgres://user:password@host:5432/dbname?sslmode=require
# DATABASE_URL=postgres://...

# ── Portail de paiement parent (Mobile Money) ────────────────────────────────
# Sénégal : passerelle Samirpay (Orange Money, Wave, Free Money)
# SAMIR_API_BASE_URL=https://api.samirpay.com/api/account/v1
# SAMIR_API_KEY=your_samir_api_key
# SAMIR_SECRET_KEY=your_samir_secret_key


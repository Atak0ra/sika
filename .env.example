# ── Copiez ce fichier en .env et remplissez vos valeurs ──────────────────────
# cp .env.example .env

# Clé secrète Django (générez-en une avec : python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())")
DJANGO_SECRET_KEY=change-me-with-a-real-secret-key

# Mode debug (True en dev, False en prod)
DJANGO_DEBUG=True

# Hôtes autorisés (séparés par des virgules)
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# ── Groq API ──────────────────────────────────────────────────────────────────
# Obtenez votre clé sur https://console.groq.com/keys
GROQ_API_KEY=gsk_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Modèle Groq à utiliser (défaut : llama-3.3-70b-versatile)
GROQ_MODEL=openai/gpt-oss-120b
